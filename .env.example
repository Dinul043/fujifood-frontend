# FujiFood Frontend — Environment Variables
# Copy this to .env.local and fill in your values

# Backend API URL (include /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Tenant Configuration
NEXT_PUBLIC_TENANT_SLUG=a2b

# Google Maps API Key
# Generate from: https://console.cloud.google.com/
# Required APIs: Maps JavaScript API
# Restrict key to: JavaScript origins (your domain)
# For development: http://localhost:3000
# For production: https://yourdomain.com
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
